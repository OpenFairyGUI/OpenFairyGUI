{
  "tests": {
    "core": "packages/core/test/**/*.test.ts",
    "functions": "packages/functions/test/**/*.test.ts",
    "backend": "packages/backend/test/**/*.test.ts",
    "cli": "packages/cli/test/**/*.test.ts",
    "mcp": "packages/mcp/test/**/*.test.ts"
  },
  "rules": [
    {
      "paths": ["packages/core/**", "packages/test-utils/**"],
      "tests": ["core", "functions", "backend", "cli", "mcp"],
      "docs": ["docs/architecture-overview.md", "docs/editor-publish-settings.md", "docs/fairygui-binary-package-format.md"]
    },
    {
      "paths": ["packages/functions/**"],
      "tests": ["functions", "backend", "cli", "mcp"],
      "docs": ["docs/architecture-overview.md", "docs/project-validation.md", "docs/editor-publish-settings.md", "docs/published-project-restore-limitations.md"]
    },
    {
      "paths": ["packages/backend/**"],
      "tests": ["backend", "cli", "mcp"],
      "docs": ["docs/architecture-overview.md", "docs/project-validation.md"]
    },
    {
      "paths": ["packages/cli/**"],
      "tests": ["cli", "backend"],
      "docs": ["docs/guide/getting-started.md", "docs/project-validation.md"]
    },
    {
      "paths": ["packages/mcp/**"],
      "tests": ["mcp"],
      "docs": ["docs/architecture-overview.md"]
    },
    {
      "paths": ["docs/.vitepress/**", "scripts/**", "agent/**", "references.json", ".github/**", ".node-version"],
      "tests": ["core", "functions", "backend", "cli", "mcp"],
      "docs": ["docs/guide/development.md", "docs/en/guide/development.md"]
    },
    {
      "paths": ["docs/**", "AGENTS.md", "README.md", "README_EN.md", "CHANGELOG.md", "CHANGELOG_CN.md"],
      "tests": [],
      "docs": ["docs/README.md", "docs/en/README.md"]
    }
  ]
}
