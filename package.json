{
	"private": true,
	"name": "openfairygui",
	"author": "OpenFairyGUI Contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenFairyGUI/OpenFairyGUI.git"
	},
	"homepage": "https://github.com/OpenFairyGUI/OpenFairyGUI#readme",
	"bugs": {
		"url": "https://github.com/OpenFairyGUI/OpenFairyGUI/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"build:cli-deps": "pnpm --filter @openfairygui/core build && pnpm --filter @openfairygui/functions build && pnpm --filter @openfairygui/backend build && pnpm --filter @openfairygui/cli build",
		"build:watch": "pnpm -r --parallel --stream --if-present run build:watch",
		"clean:dist": "node scripts/clean.mjs dist",
		"clean:deps": "node scripts/clean.mjs node_modules",
		"dev:cli": "tsx packages/cli/src/cli.ts",
		"test": "ava --no-worker-threads",
		"test:debug": "ava debug --no-worker-threads",
		"coverage": "c8 --reporter=lcov --reporter=text pnpm test -- --tap",
		"docs:api": "typedoc",
		"predocs:build": "pnpm docs:api",
		"predocs:dev": "pnpm docs:api",
		"docs:build": "vitepress build docs",
		"docs:dev": "vitepress dev docs",
		"docs:preview": "vitepress preview docs",
		"lint": "biome lint packages scripts docs/.vitepress/config.ts docs/.vitepress/theme",
		"lint:ci": "biome lint packages scripts docs/.vitepress/config.ts docs/.vitepress/theme",
		"typecheck": "tsc --noEmit --declaration false"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@types/node": "^22.0.0",
		"ava": "^7.0.0",
		"c8": "^11.0.0",
		"mermaid": "11.16.0",
		"tsdown": "^0.21.5",
		"tsx": "^4.21.0",
		"typedoc": "^0.28.20",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitepress": "^1.6.4",
		"vitepress-plugin-mermaid": "2.0.17"
	},
	"ava": {
		"extensions": {
			"ts": "module"
		},
		"nodeArguments": [
			"--import",
			"tsx/esm"
		],
		"files": [
			"packages/*/test/**/*.test.ts"
		]
	},
	"packageManager": "pnpm@10.14.0",
	"dependencies": {
		"sharp": "^0.34.5"
	}
}
