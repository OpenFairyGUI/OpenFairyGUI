{
	"compilerOptions": {
		"paths": {
			"@openfairygui/core": ["./packages/core/src/index.ts"],
			"@openfairygui/core/node": ["./packages/core/src/node.ts"],
			"@openfairygui/core/project-io": ["./packages/core/src/project-io.ts"],
			"@openfairygui/core/uam": ["./packages/core/src/uam/index.ts"],
			"@openfairygui/core/web": ["./packages/core/src/web.ts"],
			"@openfairygui/functions": ["./packages/functions/src/index.ts"],
			"@openfairygui/functions/uam": ["./packages/functions/src/uam-transaction.ts"],
			"@openfairygui/backend": ["./packages/backend/src/index.ts"],
			"@openfairygui/backend/node": ["./packages/backend/src/node.ts"],
			"@openfairygui/mcp": ["./packages/mcp/src/index.ts"],
			"@openfairygui/cli": ["./packages/cli/src/cli.ts"],
			"@openfairygui/test-utils": ["./packages/test-utils/src/index.ts"]
		},
		"esModuleInterop": true,
		"moduleResolution": "nodenext",
		"lib": ["es2022", "dom"],
		"target": "es2022",
		"module": "nodenext",
		"isolatedModules": true,
		"allowJs": false,
		"declaration": true,
		"stripInternal": true,
		"verbatimModuleSyntax": true,
		"useDefineForClassFields": true,
		"alwaysStrict": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"noImplicitThis": true
	},
	"exclude": [
		"packages/*/test/fixtures/**"
	],
	"include": [
		"packages/*/src/**/*.ts",
		"packages/*/test/**/*.ts"
	]
}
