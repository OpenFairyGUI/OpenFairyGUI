{
	"name": "@openfairygui/core",
	"version": "0.2.0-alpha.30",
	"description": "FairyGUI Headless Authoring SDK — core property graph, Document, and I/O.",
	"author": "OpenFairyGUI Contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenFairyGUI/OpenFairyGUI.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/OpenFairyGUI/OpenFairyGUI#readme",
	"bugs": {
		"url": "https://github.com/OpenFairyGUI/OpenFairyGUI/issues"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./uam": {
			"require": {
				"types": "./dist/uam/index.d.cts",
				"default": "./dist/uam/index.cjs"
			},
			"default": {
				"types": "./dist/uam/index.d.ts",
				"default": "./dist/uam/index.js"
			}
		},
		"./project-io": {
			"require": {
				"types": "./dist/project-io.d.cts",
				"default": "./dist/project-io.cjs"
			},
			"default": {
				"types": "./dist/project-io.d.ts",
				"default": "./dist/project-io.js"
			}
		},
		"./node": {
			"require": {
				"types": "./dist/node.d.cts",
				"default": "./dist/node.cjs"
			},
			"default": {
				"types": "./dist/node.d.ts",
				"default": "./dist/node.js"
			}
		},
		"./web": {
			"require": {
				"types": "./dist/web.d.cts",
				"default": "./dist/web.cjs"
			},
			"default": {
				"types": "./dist/web.d.ts",
				"default": "./dist/web.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown src/index.ts src/uam/index.ts src/project-io.ts src/node.ts src/web.ts --format esm,cjs --platform neutral --external node:fs --external node:path --external node:fs/promises --env.PACKAGE_VERSION=$npm_package_version",
		"build:watch": "tsdown src/index.ts src/uam/index.ts src/project-io.ts src/node.ts src/web.ts --watch --format esm,cjs --platform neutral --env.PACKAGE_VERSION=$npm_package_version"
	},
	"keywords": [
		"fairygui",
		"ui",
		"headless",
		"authoring",
		"fairygui-sdk",
		"fairygui-core"
	],
	"files": [
		"dist/",
		"src/"
	],
	"devDependencies": {
		"@types/pako": "^2.0.0",
		"ava": "^7.0.0",
		"tsx": "^4.0.0"
	},
	"dependencies": {
		"fast-xml-parser": "^5.0.0",
		"pako": "^2.1.0",
		"property-graph": "^4.1.0"
	}
}
