{
	"name": "@openfairygui/core",
	"version": "0.1.0",
	"description": "FairyGUI Headless Authoring SDK — core property graph, Document, and I/O.",
	"author": "OpenFairyGUI Contributors",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown --format esm,cjs --platform neutral --external node:fs --external node:path --external node:fs/promises --env.PACKAGE_VERSION=$npm_package_version",
		"build:watch": "tsdown --watch --format esm,cjs --platform neutral --env.PACKAGE_VERSION=$npm_package_version"
	},
	"keywords": [
		"fairygui",
		"ui",
		"headless",
		"authoring"
	],
	"files": [
		"dist/",
		"src/"
	],
	"devDependencies": {
		"@types/pako": "^2.0.0",
		"ava": "^7.0.0",
		"tsx": "^4.0.0"
	},
	"dependencies": {
		"fast-xml-parser": "^5.0.0",
		"pako": "^2.1.0",
		"property-graph": "^4.1.0"
	}
}
