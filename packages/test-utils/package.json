{
	"name": "@openfairygui/test-utils",
	"version": "0.2.0-alpha.9",
	"description": "FairyGUI Headless Authoring SDK — test utilities and fixtures.",
	"author": "OpenFairyGUI Contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenFairyGUI/OpenFairyGUI.git",
		"directory": "packages/test-utils"
	},
	"homepage": "https://github.com/OpenFairyGUI/OpenFairyGUI#readme",
	"bugs": {
		"url": "https://github.com/OpenFairyGUI/OpenFairyGUI/issues"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown --format esm,cjs",
		"build:watch": "tsdown --watch --format esm,cjs"
	},
	"files": [
		"dist/",
		"src/",
		"test/fixtures/"
	],
	"keywords": [
		"fairygui",
		"test",
		"fixtures",
		"utils"
	],
	"dependencies": {
		"@openfairygui/core": "workspace:*"
	}
}
